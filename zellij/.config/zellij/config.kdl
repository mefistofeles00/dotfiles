// zellij: terminal workspace (panes + tabs + persistent sessions)
// Default keys: Ctrl+p pane, Ctrl+t tab, Ctrl+n resize, Ctrl+g lock, Alt+h/j/k/l focus
theme "catppuccin-mocha"
default_layout "dev"
default_shell "zsh"
pane_frames false
mouse_mode true
copy_on_select true
scrollback_editor "nvim"
session_serialization true
show_startup_tips false
show_release_notes false
